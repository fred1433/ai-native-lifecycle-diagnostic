     #region Tests
 
+    /// <summary>
+    /// The invariant of this platform's stock: for a product that does not allow backorders, no
+    /// warehouse holds more units committed to orders than it physically has, and the committed
+    /// total never exceeds the held total.
+    ///
+    /// It is written as a property of the final state rather than as an assertion about one code
+    /// path, so that a change which reaches the same place by another route still has to satisfy it.
+    /// </summary>
+    [Test]
+    public async Task CommittedStockNeverExceedsHeldStock()
+    {
+        var product = await _productService.GetProductByIdAsync(1);
+        var backorderMode = product.BackorderMode;
+        var before = await SnapshotWarehousesAsync(product.Id);
+
+        try
+        {
+            product.BackorderMode = BackorderMode.NoBackorders;
+            await _productService.UpdateProductAsync(product);
+
+            //the fixture holds 13 units across two warehouses, 5 already committed, so 8 are available
+            await _productService.AdjustInventoryAsync(product, -4);
+
+            var records = await _productService.GetAllProductWarehouseInventoryRecordsAsync(product.Id);
+
+            foreach (var record in records)
+                record.ReservedQuantity.Should().BeLessThanOrEqualTo(record.StockQuantity,
+                    "warehouse {0} cannot commit units it does not hold", record.WarehouseId);
+
+            records.Sum(record => record.ReservedQuantity).Should()
+                .BeLessThanOrEqualTo(records.Sum(record => record.StockQuantity),
+                    "the platform cannot commit more units than it holds");
+        }
+        finally
+        {
+            await RestoreWarehousesAsync(product.Id, before);
+            product.BackorderMode = backorderMode;
+            await _productService.UpdateProductAsync(product);
+        }
+    }
+
+    [Test]
+    public async Task ReservingMoreThanTheWarehousesHoldIsRefusedWhenBackordersAreNotAllowed()
+    {
+        var product = await _productService.GetProductByIdAsync(1);
+        var backorderMode = product.BackorderMode;
+        var before = await SnapshotWarehousesAsync(product.Id);
+
+        try
+        {
+            product.BackorderMode = BackorderMode.NoBackorders;
+            await _productService.UpdateProductAsync(product);
+
+            await _productService.Invoking(service => service.AdjustInventoryAsync(product, -10))
+                .Should().ThrowAsync<NopException>();
+
+            //and the refusal is all or nothing: the first pass must not leave part of it behind
+            var records = await _productService.GetAllProductWarehouseInventoryRecordsAsync(product.Id);
+            records.Sum(record => record.ReservedQuantity).Should().Be(5);
+        }
+        finally
+        {
+            await RestoreWarehousesAsync(product.Id, before);
+            product.BackorderMode = backorderMode;
+            await _productService.UpdateProductAsync(product);
+        }
+    }
+
+    [Test]
+    public async Task ReservingWhatTheWarehousesHoldStillSucceeds()
+    {
+        var product = await _productService.GetProductByIdAsync(1);
+        var backorderMode = product.BackorderMode;
+        var before = await SnapshotWarehousesAsync(product.Id);
+
+        try
+        {
+            product.BackorderMode = BackorderMode.NoBackorders;
+            await _productService.UpdateProductAsync(product);
+
+            await _productService.AdjustInventoryAsync(product, -3);
+
+            var records = await _productService.GetAllProductWarehouseInventoryRecordsAsync(product.Id);
+            records.Sum(record => record.ReservedQuantity).Should().Be(8);
+        }
+        finally
