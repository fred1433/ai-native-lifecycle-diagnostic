+
+    /// <summary>
+    /// Restoring the exact per warehouse numbers rather than adjusting the inventory back. Releasing
+    /// stock does not return it to the warehouse it came from, so a test that undoes itself with a
+    /// second adjustment leaves a different distribution behind and the fixture quietly depends on
+    /// the order its tests happen to run in.
+    /// </summary>
+    private async Task<IList<ProductWarehouseInventory>> SnapshotWarehousesAsync(int productId)
+    {
+        return (await _productService.GetAllProductWarehouseInventoryRecordsAsync(productId))
+            .Select(record => new ProductWarehouseInventory
+            {
+                Id = record.Id,
+                ProductId = record.ProductId,
+                WarehouseId = record.WarehouseId,
+                StockQuantity = record.StockQuantity,
+                ReservedQuantity = record.ReservedQuantity
+            })
+            .ToList();
+    }
+
+    private async Task RestoreWarehousesAsync(int productId, IList<ProductWarehouseInventory> snapshot)
+    {
+        foreach (var record in await _productService.GetAllProductWarehouseInventoryRecordsAsync(productId))
+        {
+            var original = snapshot.FirstOrDefault(item => item.Id == record.Id);
+            if (original is null)
+                continue;
+
+            record.StockQuantity = original.StockQuantity;
+            record.ReservedQuantity = original.ReservedQuantity;
+            await _productService.UpdateProductWarehouseInventoryAsync(record);
+        }
+    }
