+﻿using FluentMigrator;
+using Nop.Core.Domain.Catalog;
+
+namespace Nop.Data.Migrations.UpgradeTo491;
+
+[NopSchemaMigration("2026-09-15 00:00:00", "StockReservationIndexMigration for 4.91.0")]
+public class StockReservationIndexMigration : ForwardOnlyMigration
+{
+    /// <summary>
+    /// Collect the UP migration expressions
+    /// </summary>
+    public override void Up()
+    {
+        //every reservation reads the warehouse rows of one product, and the stock total reads them
+        //twice more. The foreign key on ProductId does not carry an index of its own on SQL Server,
+        //so all three are scans on a table that grows with products multiplied by warehouses.
+        var tableName = nameof(ProductWarehouseInventory);
+        var productIdColumnName = nameof(ProductWarehouseInventory.ProductId);
+        var warehouseIdColumnName = nameof(ProductWarehouseInventory.WarehouseId);
+        var indexName = "IX_ProductWarehouseInventory_ProductId_WarehouseId";
+
+        if (!Schema.Table(tableName).Index(indexName).Exists())
+            Create.Index(indexName)
+                .OnTable(tableName)
+                .OnColumn(productIdColumnName).Ascending()
+                .OnColumn(warehouseIdColumnName).Ascending()
+                .WithOptions().NonClustered();
+    }
+}
