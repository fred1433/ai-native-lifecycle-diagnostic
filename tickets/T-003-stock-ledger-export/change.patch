+﻿using System.Globalization;
+using System.Text.Json;
+using Nop.Core.Domain.Catalog;
+using Nop.Services.Catalog;
+
+namespace Nop.Services.ExportImport;
+
+/// <summary>
+/// Stock ledger export service
+/// </summary>
+public partial class StockLedgerExportService : IStockLedgerExportService
+{
+    #region Constants
+
+    /// <summary>
+    /// The shape of the payload. The other side keys off this, so it changes when the shape changes.
+    /// </summary>
+    public const string PAYLOAD_SCHEMA = "stock-ledger/v1";
+
+    #endregion
+
+    #region Fields
+
+    protected static readonly JsonSerializerOptions _serializerOptions = new()
+    {
+        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
+        WriteIndented = false
+    };
+
+    protected readonly IProductService _productService;
+
+    #endregion
+
+    #region Ctor
+
+    public StockLedgerExportService(IProductService productService)
+    {
+        _productService = productService;
+    }
+
+    #endregion
+
+    #region Methods
+
+    /// <summary>
+    /// Export the stock movements of a product as the payload the accounting system expects
+    /// </summary>
+    public virtual async Task<string> ExportStockLedgerAsync(Product product, int warehouseId = 0)
+    {
+        ArgumentNullException.ThrowIfNull(product);
+
+        var movements = await _productService.GetStockQuantityHistoryAsync(product, warehouseId);
+
+        return BuildPayload(product.Id, product.Sku, movements);
+    }
+
+    /// <summary>
+    /// Build the payload from movements that have already been read.
+    /// </summary>
+    /// <remarks>
+    /// This is deliberately a pure function. What crosses the boundary to another company's system
+    /// has to be pinned by a test, and a test that needs a container and a database to assert one
+    /// payload is a test that gets deleted the first week it is inconvenient.
+    /// </remarks>
+    public static string BuildPayload(int productId, string sku, IList<StockQuantityHistory> movements)
+    {
+        ArgumentNullException.ThrowIfNull(movements);
+
+        var payload = new StockLedgerPayload
+        {
+            Schema = PAYLOAD_SCHEMA,
+            ProductId = productId,
+            Sku = sku,
+            Movements = movements
+                .OrderBy(movement => movement.CreatedOnUtc)
+                .ThenBy(movement => movement.Id)
+                .Select(movement => new StockLedgerMovement
+                {
+                    //the column is UTC by convention, but a row read back from the database carries no
+                    //kind at all. Without this the same movement is sent with a Z one day and without
+                    //it the next, and the other side reads the second one as local time.
+                    OccurredOnUtc = DateTime.SpecifyKind(movement.CreatedOnUtc, DateTimeKind.Utc)
+                        .ToString("O", CultureInfo.InvariantCulture),
+                    WarehouseId = movement.WarehouseId,
+                    QuantityAdjustment = movement.QuantityAdjustment,
+                    StockQuantityAfter = movement.StockQuantity,
+                    Reason = movement.Message
+                })
+                .ToList()
+        };
+
+        return JsonSerializer.Serialize(payload, _serializerOptions);
+    }
+
+    #endregion
+}
+
+/// <summary>
+/// Represents the stock ledger payload
+/// </summary>
+public partial class StockLedgerPayload
+{
+    public string Schema { get; set; }
+
+    public int ProductId { get; set; }
+
+    public string Sku { get; set; }
+
+    public IList<StockLedgerMovement> Movements { get; set; } = new List<StockLedgerMovement>();
+}
+
+/// <summary>
+/// Represents one stock movement in the ledger payload
+/// </summary>
+public partial class StockLedgerMovement
+{
+    public string OccurredOnUtc { get; set; }
+
+    public int? WarehouseId { get; set; }
+
+    public int QuantityAdjustment { get; set; }
+
+    public int StockQuantityAfter { get; set; }
+
+    public string Reason { get; set; }
+}
