+﻿using Nop.Core.Domain.Catalog;
+
+namespace Nop.Services.ExportImport;
+
+/// <summary>
+/// Stock ledger export service interface
+/// </summary>
+public partial interface IStockLedgerExportService
+{
+    /// <summary>
+    /// Export the stock movements of a product as the payload the accounting system expects
+    /// </summary>
+    /// <param name="product">Product</param>
+    /// <param name="warehouseId">Warehouse identifier; pass 0 for all warehouses</param>
+    /// <returns>
+    /// A task that represents the asynchronous operation
+    /// The task result contains the payload
+    /// </returns>
+    Task<string> ExportStockLedgerAsync(Product product, int warehouseId = 0);
+}
diff --git a/src/Libraries/Nop.Services/ExportImport/StockLedgerExportService.cs b/src/Libraries/Nop.Services/ExportImport/StockLedgerExportService.cs
