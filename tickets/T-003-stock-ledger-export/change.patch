+﻿using FluentAssertions;
+using Nop.Core.Domain.Catalog;
+using Nop.Services.ExportImport;
+using NUnit.Framework;
+
+namespace Nop.Tests.Nop.Services.Tests.ExportImport;
+
+[TestFixture]
+public class StockLedgerExportServiceTests
+{
+    /// <summary>
+    /// What we send to the accounting system today, byte for byte. This fixture does not claim the
+    /// shape is right. It claims that changing it is a decision somebody makes on purpose, because
+    /// the party that would otherwise notice is on the other side of the integration, a day later.
+    /// </summary>
+    private const string EXPECTED_PAYLOAD =
+        "{\u0022schema\u0022:\u0022stock-ledger/v1\u0022,\u0022productId\u0022:42,\u0022sku\u0022:\u0022SKU-42\u0022,\u0022movements\u0022:[" +
+        "{\u0022occurredOnUtc\u0022:\u00222026-09-01T08:00:00.0000000Z\u0022,\u0022warehouseId\u0022:1,\u0022quantityAdjustment\u0022:-2,\u0022stockQuantityAfter\u0022:6,\u0022reason\u0022:\u0022Order 4100\u0022}," +
+        "{\u0022occurredOnUtc\u0022:\u00222026-09-02T09:30:00.0000000Z\u0022,\u0022warehouseId\u0022:null,\u0022quantityAdjustment\u0022:5,\u0022stockQuantityAfter\u0022:11,\u0022reason\u0022:\u0022Stock received\u0022}]}";
+
+    private static IList<StockQuantityHistory> TwoMovements()
+    {
+        return new List<StockQuantityHistory>
+        {
+            new()
+            {
+                Id = 2,
+                ProductId = 42,
+                WarehouseId = null,
+                QuantityAdjustment = 5,
+                StockQuantity = 11,
+                Message = "Stock received",
+                CreatedOnUtc = new DateTime(2026, 9, 2, 9, 30, 0, DateTimeKind.Utc)
+            },
+            new()
+            {
+                Id = 1,
+                ProductId = 42,
+                WarehouseId = 1,
+                QuantityAdjustment = -2,
+                StockQuantity = 6,
+                Message = "Order 4100",
+                CreatedOnUtc = new DateTime(2026, 9, 1, 8, 0, 0, DateTimeKind.Utc)
+            }
+        };
+    }
+
+    [Test]
+    public void ThePayloadCrossingTheBoundaryIsPinned()
+    {
+        var payload = StockLedgerExportService.BuildPayload(42, "SKU-42", TwoMovements());
+
+        payload.Should().Be(EXPECTED_PAYLOAD);
+    }
+
+    [Test]
+    public void MovementsAreOrderedByWhenTheyHappenedNotByHowTheyArrived()
+    {
+        var payload = StockLedgerExportService.BuildPayload(42, "SKU-42", TwoMovements());
+
+        payload.IndexOf("2026-09-01", StringComparison.Ordinal)
+            .Should().BeLessThan(payload.IndexOf("2026-09-02", StringComparison.Ordinal));
+    }
+
+    [Test]
+    public void ATimestampReadBackFromTheDatabaseIsStillSentAsUtc()
+    {
+        //rows come back from the provider with no kind at all; the column is UTC by convention only
+        var movements = new List<StockQuantityHistory>
+        {
+            new()
+            {
+                Id = 1,
+                ProductId = 42,
+                WarehouseId = 1,
+                QuantityAdjustment = -1,
+                StockQuantity = 5,
+                Message = "Order 4101",
+                CreatedOnUtc = new DateTime(2026, 9, 1, 8, 0, 0, DateTimeKind.Unspecified)
+            }
+        };
+
+        var payload = StockLedgerExportService.BuildPayload(42, "SKU-42", movements);
+
+        payload.Should().Contain("2026-09-01T08:00:00.0000000Z");
+    }
+}
