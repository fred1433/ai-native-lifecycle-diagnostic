<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Boundary rules for the upstream platform. The package versions deliberately match the
    ones the upstream test project already uses, so the restore graph of the harness and of
    the platform cannot drift apart.

    UpstreamRoot points at the checkout produced by scripts/fetch_upstream.sh. The upstream
    is never copied into this repository.
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>NU1901;NU1902;NU1903;NU1904</NoWarn>
    <UpstreamRoot Condition="'$(UpstreamRoot)' == ''">$(MSBuildThisFileDirectory)..\..\upstream</UpstreamRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(UpstreamRoot)\src\Presentation\Nop.Web\Nop.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="baseline\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
